---
import Icon from '../ui/Icon.astro';
---

<a
  href="https://wa.me/5575998954848?text=Ol%C3%A1!%20Vi%20o%20site%20e%20gostaria%20de%20informa%C3%A7%C3%B5es%20sobre%20matr%C3%ADculas%20na%20Escola%20Prisma."
  class="whatsapp-float"
  id="cta-whatsapp-float"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Fale conosco pelo WhatsApp"
  data-ga4-event="click_whatsapp_float"
  data-ga4-location="global"
>
  <Icon name="whatsapp" size="xl" class="whatsapp-icon" />
</a>

<style>
  .whatsapp-float {
    position: fixed;
    bottom: 32px;
    right: 32px;
    width: 64px;
    height: 64px;
    background: #25D366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);
    z-index: 998;
    transition: all var(--transition-base);
  }

  .whatsapp-icon {
    color: white;
  }

  .whatsapp-float:hover {
    transform: scale(1.1) translateY(-5px);
    box-shadow: 0 12px 32px rgba(37, 211, 102, 0.5);
  }

  .whatsapp-float:focus-visible {
    outline: 3px solid #25D366;
    outline-offset: 4px;
  }

  .whatsapp-icon {
    width: 32px;
    height: 32px;
  }

  @media (max-width: 768px) {
    .whatsapp-float {
      bottom: 24px;
      right: 24px;
      width: 56px;
      height: 56px;
    }
  }
</style>