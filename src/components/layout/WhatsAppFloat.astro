---
import { whatsappLink } from "../../data/escola";
import { menuRodape } from '../../data/menu';
import Icon from '../ui/Icon.astro';

// Assunto e rótulo em src/content/site/menu-rodape.json ("botaoFlutuante"; painel: "Menu e rodapé").
const { botaoFlutuante } = menuRodape;
---

<a
  href={whatsappLink(botaoFlutuante.whatsappAssunto)}
  class="whatsapp-float"
  id="cta-whatsapp-float"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={botaoFlutuante.rotulo}
  data-ga4-event="click_whatsapp_float"
  data-ga4-location="global"
>
  <Icon name="whatsapp" size="xl" class="whatsapp-icon" />
</a>

<style>
  .whatsapp-float {
    position: fixed;
    bottom: 32px;
    right: 32px;
    width: 64px;
    height: 64px;
    background: #25D366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);
    z-index: 998;
    transition: all var(--transition-base);
  }

  .whatsapp-icon {
    color: white;
  }

  .whatsapp-float:hover {
    transform: scale(1.1) translateY(-5px);
    box-shadow: 0 12px 32px rgba(37, 211, 102, 0.5);
  }

  .whatsapp-float:focus-visible {
    outline: 3px solid #25D366;
    outline-offset: 4px;
  }

  .whatsapp-icon {
    width: 32px;
    height: 32px;
  }

  @media (max-width: 768px) {
    .whatsapp-float {
      bottom: 24px;
      right: 24px;
      width: 56px;
      height: 56px;
    }
  }
</style>