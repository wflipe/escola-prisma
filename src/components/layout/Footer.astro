---
import { escola, whatsappLink } from "../../data/escola";
import { menuRodape } from '../../data/menu';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';

// Textos em src/content/site/menu-rodape.json ("rodape"; painel: "Menu e rodapé").
// Slogan, endereço e telefones vêm de escola.json (painel: "Dados da escola").
const { rodape } = menuRodape;
---

<footer class="footer">
  <Container class="footer-container">
    <div class="footer-grid">
      <div class="footer-brand">
        <picture>
          <source srcset="/assets/logo.webp" type="image/webp" />
          <img src="/assets/logo.png" alt={`Logotipo ${escola.nome}`} width="270" height="90" style="height: 90px; width: auto; max-width: 100%; object-fit: contain;" />
        </picture>
        <p>{escola.slogan}</p>
      </div>

      <div class="footer-contact">
        <h3>{rodape.tituloContato}</h3>
        <p class="footer-address">
          <Icon name="location-dot" size="md" />
          <span>{escola.endereco.logradouro}<br>{escola.endereco.cidade} - {escola.endereco.uf} | CEP {escola.endereco.cep}</span>
        </p>
        <p class="footer-phone">
          <Icon name="phone" size="md" />
          <a href={`tel:${escola.telefoneFixo.e164}`}>{escola.telefoneFixo.exibicao} {rodape.sufixoFixo}</a>
        </p>
        <p class="footer-phone">
          <Icon name="whatsapp" size="md" />
          <a href={whatsappLink(rodape.whatsappAssunto)} target="_blank" rel="noopener noreferrer">{escola.whatsapp.exibicao} {rodape.sufixoWhatsapp}</a>
        </p>
      </div>

      <div class="footer-map">
        <h3>{rodape.tituloMapa}</h3>
        <iframe
          src={rodape.mapaEmbed}
          width="100%"
          height="200"
          style="border: 0; border-radius: 12px;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title={rodape.mapaRotulo}
        ></iframe>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {rodape.direitos}</p>
    </div>
  </Container>
</footer>

<style>
  .footer {
    background: var(--color-surface);
  }

  .footer-container {
    padding-top: 4rem;
    padding-bottom: 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .footer-brand img {
    height: 45px;
    width: auto;
    margin-bottom: 1rem;
  }

  .footer-brand p {
    color: var(--color-text-muted);
    font-style: italic;
    font-weight: 500;
  }

  .footer-contact h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--color-white);
  }

  .footer-address {
    display: flex;
    gap: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    align-items: flex-start;
  }

  .footer-address svg {
    flex-shrink: 0;
    margin-top: 0.25rem;
    color: var(--color-primary);
  }

  .footer-phone {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-text-muted);
  }

  .footer-phone svg {
    color: var(--color-primary);
  }

  .footer-phone a {
    color: var(--color-text-muted);
    transition: color var(--transition-base);
  }

  .footer-phone a:hover {
    color: var(--color-primary);
  }

  .footer-bottom {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
</style>