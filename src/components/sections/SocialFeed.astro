---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import type { InstagramData } from '../../types/content';
import instagramData from '../../content/site/secao-instagram.json';
import { escola } from '../../data/escola';
import { partesDoTitulo } from '../../utils/titulo';

/** Textos em src/content/site/secao-instagram.json (painel: "Instagram"); @ e link do perfil em escola.json. */
const data = instagramData as InstagramData;
const titulo = partesDoTitulo(data.titulo, data.tituloDestaque);
---

<Section id="instagram" background="gray" padding="xl" class="social-feed">
  <Container>
    <div class="social-feed-header">
      <a class="social-badge" href={escola.instagram.url} target="_blank" rel="noopener noreferrer">
        <Icon name="instagram" size="sm" />
        <span>{escola.instagram.usuario}</span>
      </a>
      <h2 class="title">
        {titulo.map((p) => p.quebra ? <br /> : p.destaque ? <span class="font-serif italic text-primary">{p.texto}</span> : p.texto)}
      </h2>
      <p class="subtitle">
        {data.texto}
      </p>
    </div>

    <div class="feed-container">
      <!-- Place <div> tag where you want the feed to appear -->
      <div id="curator-feed"><a href="https://curator.io" target="_blank" rel="nofollow noopener noreferrer" class="crt-logo crt-tag">Powered by Curator.io</a></div>
    </div>
  </Container>

  <!-- The Javascript can be moved to the end of the html page before the </body> tag -->
  <script type="text/javascript" is:inline>
  /* curator-feed lazy load */
  document.addEventListener("DOMContentLoaded", function() {
    var feedContainer = document.getElementById("curator-feed");
    if (!feedContainer) return;

    var observer = new IntersectionObserver(function(entries) {
      if (entries[0].isIntersecting) {
        var i,e,d=document,s="script";i=d.createElement("script");i.async=1;i.charset="UTF-8";
        i.src="https://cdn.curator.io/published/cb5b7056-5624-4fe0-8dbc-02113ba4.js";
        e=d.getElementsByTagName(s)[0];e.parentNode.insertBefore(i, e);
        observer.disconnect();
      }
    }, { rootMargin: "200px" });

    observer.observe(feedContainer);
  });
  </script>
</Section>

<style>
  .social-feed-header {
    text-align: center;
    max-width: 48rem;
    margin: 0 auto 3rem;
  }

  .social-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: white;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 1rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    text-decoration: none;
  }

  .title {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .title {
      font-size: 2.5rem;
    }
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .feed-container {
    width: 100%;
    border-radius: 1.5rem;
    overflow: hidden;
    background: white;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
    padding: 1rem;
  }

  /* Reserva espaço para o feed do Instagram, que é injetado por JS ao rolar a página:
     sem isso o conteúdo abaixo "pula" quando o feed aparece (CLS). */
  #curator-feed {
    min-height: 520px;
  }

  @media (min-width: 768px) {
    #curator-feed {
      min-height: 420px;
    }
  }
</style>
