---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
---

<Section id="instagram" background="gray" padding="xl" class="social-feed">
  <Container>
    <div class="social-feed-header">
      <div class="social-badge">
        <Icon name="instagram" size="sm" />
        <span>@escolaprisma</span>
      </div>
      <h2 class="title">
        Acompanhe nosso <span class="font-serif italic text-primary">dia a dia</span>
      </h2>
      <p class="subtitle">
        Veja na prática como é a rotina, os eventos e as conquistas dos nossos alunos.
      </p>
    </div>

    <div class="feed-container">
      <!-- Place <div> tag where you want the feed to appear -->
      <div id="curator-feed"><a href="https://curator.io" target="_blank" class="crt-logo crt-tag">Powered by Curator.io</a></div>
    </div>
  </Container>

  <!-- The Javascript can be moved to the end of the html page before the </body> tag -->
  <script type="text/javascript" is:inline>
  /* curator-feed lazy load */
  document.addEventListener("DOMContentLoaded", function() {
    var feedContainer = document.getElementById("curator-feed");
    if (!feedContainer) return;

    var observer = new IntersectionObserver(function(entries) {
      if (entries[0].isIntersecting) {
        var i,e,d=document,s="script";i=d.createElement("script");i.async=1;i.charset="UTF-8";
        i.src="https://cdn.curator.io/published/cb5b7056-5624-4fe0-8dbc-02113ba4.js";
        e=d.getElementsByTagName(s)[0];e.parentNode.insertBefore(i, e);
        observer.disconnect();
      }
    }, { rootMargin: "200px" });

    observer.observe(feedContainer);
  });
  </script>
</Section>

<style>
  .social-feed-header {
    text-align: center;
    max-width: 48rem;
    margin: 0 auto 3rem;
  }

  .social-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: white;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 1rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }

  .title {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .title {
      font-size: 2.5rem;
    }
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .feed-container {
    width: 100%;
    border-radius: 1.5rem;
    overflow: hidden;
    background: white;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
    padding: 1rem;
  }
</style>
