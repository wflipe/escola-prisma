---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import Card from '../ui/Card.astro';
import type { ValoresData } from '../../types/content';
import valoresData from '../../content/site/secao-valores.json';
import { partesDoTitulo } from '../../utils/titulo';

/** Textos em src/content/site/secao-valores.json (painel: "Valores cristãos"). */
const data = valoresData as ValoresData;
const titulo = partesDoTitulo(data.titulo, data.tituloDestaque);

/** Cor do ícone de cada cartão, pela posição (repete a partir do 4º). */
const cores = ['color-orange', 'color-blue', 'color-yellow'];
---

<Section id="valores-cristaos" background="white" padding="xl" class="christian-values">
  <Container>
    <div class="values-header">
      <div class="badge">{data.selo}</div>
      <h2 class="title">
        {titulo.map((p) => p.quebra ? <br /> : p.destaque ? <span class="font-serif italic text-primary">{p.texto}</span> : p.texto)}
      </h2>
      <p class="subtitle">
        {data.texto}
      </p>
    </div>

    <div class="values-grid">
      {data.cartoes.map((cartao, index) => (
        <Card variant="bordered" padding="lg" hover class="value-card">
          <div class={`icon-container ${cores[index % cores.length]}`}>
            <Icon name={cartao.icone} size="lg" />
          </div>
          <h3>{cartao.titulo}</h3>
          <p>{cartao.texto}</p>
        </Card>
      ))}
    </div>
  </Container>
</Section>

<style>
  .christian-values {
    position: relative;
    border-top: 1px solid var(--color-border);
  }

  .values-header {
    text-align: center;
    max-width: 56rem;
    margin: 0 auto 4rem;
  }

  .badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(246, 122, 33, 0.1);
    color: var(--color-primary);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  .title {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
    color: var(--color-secondary);
    line-height: 1.1;
  }

  @media (min-width: 768px) {
    .title {
      font-size: 3.5rem;
    }
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 48rem;
    margin: 0 auto;
  }

  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .values-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .value-card {
    text-align: left;
    height: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .value-card:hover {
    transform: translateY(-5px);
    border-color: rgba(246, 122, 33, 0.3);
    box-shadow: var(--shadow-lg);
  }

  .icon-container {
    width: 60px;
    height: 60px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .color-orange {
    background: rgba(246, 122, 33, 0.1);
    color: var(--color-primary);
  }

  .color-blue {
    background: rgba(21, 46, 101, 0.1);
    color: var(--color-secondary);
  }

  .color-yellow {
    background: rgba(249, 185, 26, 0.15);
    color: var(--color-yellow);
  }

  h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--color-secondary);
  }

  p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }
</style>
