---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';
import type { PropostaData } from '../../types/content';
import propostaData from '../../content/site/secao-proposta.json';
import { partesDoTitulo } from '../../utils/titulo';

/** Textos em src/content/site/secao-proposta.json (painel: "A Escola (proposta)"). */
const data = propostaData as PropostaData;
const titulo = partesDoTitulo(data.titulo, data.tituloDestaque);

/** Cor de cada cartão, pela posição (repete a partir do 4º). */
const cores = [
  '--card-color: #F67A21; --card-bg: rgba(246, 122, 33, 0.1);',
  '--card-color: #06B6D4; --card-bg: rgba(6, 182, 212, 0.1);',
  '--card-color: #10B981; --card-bg: rgba(16, 185, 129, 0.1);',
];
---

<Section id="proposta" background="gray" padding="xl" class="problema-solucao">
  <Container>
    <div class="section-header">
      <span class="section-tagline">{data.selo}</span>
      <h2>
        {titulo.map((p) => p.quebra ? <br /> : p.destaque ? <span class="font-serif italic text-primary">{p.texto}</span> : p.texto)}
      </h2>
      <p>
        {data.texto}
      </p>
    </div>

    <div class="features-grid">
      {data.cartoes.map((cartao, index) => (
        <Card variant="bordered" padding="lg" hover class="feature-card" style={cores[index % cores.length]}>
          <div class="feature-icon">
            <Icon name={cartao.icone} size="xl" />
          </div>
          <h3>{cartao.titulo}</h3>
          <p>{cartao.texto}</p>
        </Card>
      ))}
    </div>
  </Container>
</Section>

<style>
  .problema-solucao {
    position: relative;
    border-bottom: 1px solid rgba(15, 23, 42, 0.05);
  }

  .section-header {
    text-align: center;
    max-width: 48rem;
    margin: 0 auto 4rem;
  }

  .section-tagline {
    display: block;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .section-header h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-secondary);
    margin-bottom: 1.5rem;
  }

  .section-header p {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature-card {
    padding: 2.5rem 2rem;
    border-radius: 1.5rem;
    transition: all var(--transition-slow);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .feature-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 15px 35px color-mix(in srgb, var(--card-color) 15%, transparent);
  }

  .feature-icon {
    width: 4rem;
    height: 4rem;
    border-radius: 1rem;
    background: var(--card-bg, rgba(255, 102, 2, 0.1));
    color: var(--card-color, var(--color-primary));
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    transition: all var(--transition-base);
  }

  :global(.feature-card:hover) .feature-icon {
    background: var(--card-color, var(--color-primary));
    color: white;
    transform: scale(1.1) rotate(5deg);
  }

  .feature-card h3 {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--color-secondary);
    margin-bottom: 0.75rem;
  }

  .feature-card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>