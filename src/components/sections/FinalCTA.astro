---
import { whatsappLink } from "../../data/escola";
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import type { ChamadaFinalData } from '../../types/content';
import chamadaFinalData from '../../content/site/secao-chamada-final.json';
import { partesDoTitulo } from '../../utils/titulo';

/** Textos em src/content/site/secao-chamada-final.json (painel: "Chamada final (visita)"). */
const data = chamadaFinalData as ChamadaFinalData;
const titulo = partesDoTitulo(data.titulo, data.tituloDestaque);
---

<Section background="none" padding="xl" class="cta-final bg-noise bg-mesh-warm">
  <span class="cta-blob cta-blob-1"></span>
  <span class="cta-blob cta-blob-2"></span>
  <Container>
    <h2 class="cta-title">
      {titulo.map((p) => p.quebra ? <br /> : p.destaque ? <span class="font-serif italic text-primary">{p.texto}</span> : p.texto)}
    </h2>
    <p class="cta-text">
      {data.texto}
    </p>
    <Button
      href={whatsappLink(data.botao.whatsappAssunto)}
      target="_blank"
      rel="noopener noreferrer"
      variant="primary"
      size="xl"
      data-ga4-event="click_agendar_visita"
      data-ga4-location="final_cta"
    >
      {data.botao.text}
      <Icon name="arrow-right" size="md" />
    </Button>
    <p class="cta-apoio">
      {data.apoio}<br>
      <span class="micro-copy">{data.microTexto}</span>
    </p>
  </Container>
</Section>

<style>
  .cta-final {
    position: relative;
    overflow: hidden;
    color: var(--color-secondary);
    text-align: center;
  }

  .cta-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    animation: pulseSlow 8s ease-in-out infinite;
  }

  .cta-blob-1 {
    width: 420px;
    height: 420px;
    left: -100px;
    top: 10px;
    background: rgba(255, 102, 2, 0.15);
  }

  .cta-blob-2 {
    width: 480px;
    height: 480px;
    right: -100px;
    bottom: 10px;
    background: rgba(6, 182, 212, 0.1);
    animation-delay: -9s;
  }

  .cta-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 0.95;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-secondary) !important;
    margin-bottom: 2rem;
  }

  .cta-text {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: 1.6;
    color: var(--color-text-muted) !important;
    max-width: 46rem;
    margin: 0 auto 2.5rem;
  }

  .cta-apoio {
    margin-top: 2rem;
    font-size: 0.875rem;
    color: var(--color-text-muted) !important;
    line-height: 1.6;
  }

  .micro-copy {
    color: var(--color-text-muted) !important;
  }
</style>