---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Section from '../ui/Section.astro';
import { Image } from 'astro:assets';
import studentInfantil from '../../assets/images/student-infantil.png';
import studentFundamental from '../../assets/images/student-fundamental.png';
import studentMedio from '../../assets/images/student-medio.png';
import type { HeroData } from '../../content/site/hero';

interface Props {
  data: HeroData;
}

const { data } = Astro.props;
---

<Section id="inicio" class="hero" padding="none">
  <!-- Background effects -->
  <div class="hero-bg-effects">
    <div class="hero-grid-overlay"></div>
    <span class="hero-blob hero-blob-1"></span>
    <span class="hero-blob hero-blob-2"></span>
    <span class="hero-blob hero-blob-3"></span>
  </div>

  <Container class="hero-container">
    <div class="hero-content">
      <div class="trust-badge">
        <Icon name="star" size="sm" />
        <span>Formação humana · Acolhimento · Vestibular</span>
      </div>

      <h1 class="hero-title">
        Seu filho preparado para o mundo, com o <span class="font-serif italic text-accent">cuidado</span> que ele merece hoje.
      </h1>

      <p class="hero-lead">
        Da Educação Infantil ao Ensino Médio, combinamos ensino consistente, inglês avançado, esporte e acompanhamento próximo, em uma escola onde seu filho é reconhecido pelo nome.
      </p>

      <div class="hero-actions">
        <Button
          href={data.primaryCTA.link}
          target="_blank"
          rel="noopener noreferrer"
          variant="primary"
          size="xl"
          data-ga4-event="click_agendar_visita"
          data-ga4-location="hero"
          class="hero-cta"
        >
          {data.primaryCTA.text}
          <Icon name="arrow-right" size="md" />
        </Button>

        <div class="urgency-text">
          <Icon name="star" size="sm" />
          <span>{data.trustIndicators.map(i => i.text).join(' · ')}</span>
        </div>
      </div>
    </div>

    <!-- Floating Cards Section (Inspirada nas fotos sobrepostas do Lumos) -->
    <div class="hero-showcase">
      <!-- Card 1: Educação Infantil -->
      <div class="student-card card-infantil float-slow">
        <div class="student-avatar-container">
          <Image src={studentInfantil} alt="Aluno da Educação Infantil Prisma" class="student-img" width={400} height={400} />
          <span class="verify-badge">✓</span>
        </div>
        <div class="student-info">
          <div class="student-name">Arthur <span class="text-accent">★</span></div>
          <div class="student-tag">ALFABETIZADO AOS 6 ANOS</div>
        </div>
      </div>

      <!-- Card 2: Ensino Fundamental -->
      <div class="student-card card-fundamental float-slow" style="animation-delay: -2s;">
        <div class="student-avatar-container">
          <Image src={studentFundamental} alt="Aluna do Ensino Fundamental Prisma" class="student-img" width={400} height={400} />
          <span class="verify-badge bg-primary">✓</span>
        </div>
        <div class="student-info">
          <div class="student-name">Laura</div>
          <div class="student-tag">INGLÊS FLUENTE & ROBÓTICA</div>
        </div>
      </div>

      <!-- Card 3: Ensino Médio/Aprovação -->
      <div class="student-card card-medio float-slow" style="animation-delay: -4s;">
        <div class="student-avatar-container">
          <Image src={studentMedio} alt="Aluno do Ensino Médio Prisma" class="student-img" width={400} height={400} />
          <span class="verify-badge bg-success">✓</span>
        </div>
        <div class="student-info">
          <div class="student-name">Gabriel</div>
          <div class="student-tag">MEDICINA · UEFS</div>
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    background-color: var(--color-secondary);
    background-image:
      radial-gradient(at 0% 0%, rgba(255, 102, 2, 0.15) 0px, transparent 50%),
      radial-gradient(at 100% 100%, rgba(245, 158, 11, 0.12) 0px, transparent 50%),
      radial-gradient(at 50% 50%, rgba(15, 23, 42, 0.95) 0px, transparent 80%);
    color: white;
  }

  .hero-bg-effects {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    background-size: 40px 40px;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    opacity: 0.5;
  }

  .hero-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    animation: pulseSlow 8s ease-in-out infinite;
  }

  .hero-blob-1 {
    width: 520px;
    height: 520px;
    left: -130px;
    top: 10px;
    background: rgba(255, 102, 2, 0.3);
  }

  .hero-blob-2 {
    width: 600px;
    height: 600px;
    right: -130px;
    bottom: 0;
    background: rgba(6, 182, 212, 0.2);
    animation-delay: -6s;
  }

  .hero-blob-3 {
    width: 380px;
    height: 380px;
    left: 50%;
    top: 33%;
    background: rgba(245, 158, 11, 0.15);
    animation-delay: -12s;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    padding-top: 2rem;
    padding-bottom: 2rem;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1.2fr 1fr;
      gap: 5rem;
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
  }

  .hero-content {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .hero-content {
      text-align: left;
      margin: 0;
    }
  }

  .trust-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 102, 2, 0.15);
    color: var(--color-primary-light);
    border: 1px solid rgba(255, 102, 2, 0.25);
    border-radius: 9999px;
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    backdrop-filter: blur(8px);
  }

  @media (min-width: 640px) {
    .trust-badge {
      font-size: 0.875rem;
      padding: 0.5rem 1.25rem;
      margin-bottom: 2rem;
    }
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: white;
    margin-bottom: 2rem;
  }

  .hero-lead {
    font-size: clamp(1.125rem, 2vw, 1.35rem);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.5;
    margin-bottom: 3rem;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  .hero-cta {
    background: var(--color-primary);
    color: white;
    border-radius: 9999px;
    padding: 1.25rem 2.5rem;
    box-shadow: 0 4px 15px rgba(255, 102, 2, 0.3);
    transition: all var(--transition-base);
    white-space: nowrap;
  }

  .hero-cta:hover {
    transform: scale(1.03);
    box-shadow: 0 8px 25px rgba(255, 102, 2, 0.4);
    background: var(--color-primary-dark);
  }

  .urgency-text {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .urgency-text svg {
    color: var(--color-accent);
  }

  /* Floating Showcase Layout (Inspirada no Lumos) */
  .hero-showcase {
    position: relative;
    height: 480px;
    width: 100%;
    margin-top: 3rem;
  }

  @media (min-width: 1024px) {
    .hero-showcase {
      margin-top: 0;
    }
  }

  .student-card {
    position: absolute;
    width: 230px;
    background: white;
    padding: 0.75rem;
    border-radius: 1.25rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
    transform-origin: center;
    transition: all var(--transition-base);
    cursor: pointer;
    z-index: 10;
  }

  .student-card:hover {
    transform: scale(1.08) rotate(0deg) !important;
    z-index: 30;
  }

  .card-infantil {
    top: 10px;
    right: 40px;
    transform: rotate(-8deg);
  }

  .card-fundamental {
    left: 10px;
    top: 110px;
    transform: rotate(-14deg);
  }

  .card-medio {
    right: 15px;
    bottom: 10px;
    transform: rotate(5deg);
  }

  .student-avatar-container {
    position: relative;
    aspect-ratio: 4/5;
    border-radius: 0.875rem;
    overflow: hidden;
    background: var(--color-secondary);
  }

  .student-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .verify-badge {
    position: absolute;
    bottom: -0.5rem;
    right: -0.5rem;
    width: 1.75rem;
    height: 1.75rem;
    background: var(--color-accent);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
    border: 2px solid white;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  }

  .student-info {
    margin-top: 0.75rem;
    text-align: center;
  }

  .student-name {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-secondary);
  }

  .student-tag {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-top: 0.15rem;
  }
</style>