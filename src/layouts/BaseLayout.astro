---
import TopBar from '../components/layout/TopBar.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFloat from '../components/layout/WhatsAppFloat.astro';
import type { SchemaOrg } from '../utils/schema';
import '../styles/globals.css';

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  schema?: SchemaOrg;
  noIndex?: boolean;
}

const {
  title,
  description,
  canonicalURL = 'https://www.escolaprisma.com',
  ogImage = '/assets/escola-prisma-marca-1200x630.png',
  schema,
  noIndex = false,
} = Astro.props;

const currentYear = new Date().getFullYear();
const structuredData = schema ? JSON.stringify(schema) : '';
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />

  {noIndex && <meta name="robots" content="noindex, nofollow" />}

  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <meta name="geo.region" content="BR-BA" />
  <meta name="geo.placename" content="Feira de Santana" />
  <meta name="geo.position" content="-12.2858;-38.9556" />
  <meta name="ICBM" content="-12.2858, -38.9556" />

  <meta name="theme-color" content="#F67A21" />

  <link rel="preconnect" href="https://www.googletagmanager.com" />

  {structuredData && (
    <script type="application/ld+json" set:html={structuredData} />
  )}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;700;800&family=Instrument+Serif:ital@0;1&family=Montserrat:wght@300;400;500;600&display=swap" />
</head>
<body>


  <TopBar />
  <Header />
  <MobileMenu />

  <main id="main-content">
    <slot />
  </main>

  <Footer />
  <WhatsAppFloat />

  <button id="back-to-top" class="back-to-top" aria-label="Voltar ao topo" hidden>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m18 15-6-6-6 6" />
    </svg>
  </button>



  <script is:inline src="../scripts/mobile-menu.js"></script>
  <script is:inline src="../scripts/back-to-top.js"></script>
  <script is:inline src="../scripts/slider.js"></script>
</body>
</html>