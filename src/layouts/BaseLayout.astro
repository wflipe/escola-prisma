---
import EnrollmentStrip from '../components/layout/EnrollmentStrip.astro';
import TopBar from '../components/layout/TopBar.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFloat from '../components/layout/WhatsAppFloat.astro';
import { Font } from 'astro:assets';
import type { SchemaOrg } from '../utils/schema';
import { escola } from '../data/escola';
import type { SeoData } from '../types/content';
import seoData from '../content/site/seo.json';
import { exigirArquivoPublico } from '../utils/arquivos';
import '../styles/globals.css';

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  schema?: SchemaOrg | SchemaOrg[];
  noIndex?: boolean;
  /**
   * Prefixo dos links do menu. Na home os links são "#proposta" (rolam a própria
   * página); em outra página (ex.: 404) use "/" para virar "/#proposta".
   */
  prefixoMenu?: string;
}

const {
  title,
  description,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  ogImage: ogImagePath = (seoData as SeoData).ogImage,
  schema,
  noIndex = false,
  prefixoMenu = '',
} = Astro.props;

// Imagem padrão de compartilhamento: src/content/site/seo.json (ogImage).
// O build falha com mensagem clara se o arquivo não existir em public/.
exigirArquivoPublico(ogImagePath, 'seo.json, campo ogImage ("Imagem de compartilhamento")');
// Open Graph (WhatsApp, Facebook, Instagram) exige URL absoluta da imagem.
const ogImage = new URL(ogImagePath, Astro.site).href;
const ogImageAlt = (seoData as SeoData).ogImageAlt;

const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

// JSON-LD dentro de <script>: escapa "<" para um texto com "</script>" não quebrar o bloco.
const jsonLd = (item: SchemaOrg) => JSON.stringify(item).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Tag do Google (contêiner GTM-NRQ8DB4L, ligado ao Google Analytics). Logo no início do <head>, como o Google pede.
       Só carrega no domínio oficial, para não contar localhost nem previews da Vercel. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    if (/(^|\.)escolaprisma\.net\.br$/.test(location.hostname)) {
      gtag('js', new Date());
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-NRQ8DB4L';
      document.head.appendChild(s);
    }
  </script>
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  {noIndex && <meta name="robots" content="noindex, nofollow" />}

  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:site_name" content={escola.nome} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <meta name="geo.region" content={`${escola.endereco.pais}-${escola.endereco.uf}`} />
  <meta name="geo.placename" content={escola.endereco.cidade} />
  <meta name="geo.position" content={`${escola.geo.latitude};${escola.geo.longitude}`} />
  <meta name="ICBM" content={`${escola.geo.latitude}, ${escola.geo.longitude}`} />

  <meta name="theme-color" content="#F67A21" />

  <!-- Fontes do próprio site; preload só da fonte dos títulos (Bricolage é variável: um arquivo para todos os pesos). -->
  <Font cssVariable="--font-bricolage" preload />
  <Font cssVariable="--font-montserrat" />
  <Font cssVariable="--font-instrument" />

  {schemas.map((item) => (
    <script type="application/ld+json" set:html={jsonLd(item)} />
  ))}

  <!-- Umami (estatísticas de visitas, sem cookies). data-domains: só conta o site oficial, não localhost nem previews da Vercel. -->
  <script
    is:inline
    defer
    src="https://cloud.umami.is/script.js"
    data-website-id="531d3b02-006f-478e-896b-36b7a394d576"
    data-domains="www.escolaprisma.net.br,escolaprisma.net.br"
  ></script>

  <!-- Microsoft Clarity (zda9hbje8t) é carregado pelo Google Tag Manager (tag "Microsoft Clarity - Official"), não aqui. -->
</head>
<body>


  <EnrollmentStrip />
  <TopBar />
  <Header prefixoMenu={prefixoMenu} />
  <MobileMenu prefixoMenu={prefixoMenu} />

  <main id="main-content">
    <slot />
  </main>

  <Footer />
  <WhatsAppFloat />

  <button id="back-to-top" class="back-to-top" aria-label="Voltar ao topo" hidden>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m18 15-6-6-6 6" />
    </svg>
  </button>



  <script>
    import '../scripts/mobile-menu';
    import '../scripts/back-to-top';
    import '../scripts/analytics';
  </script>
</body>
</html>