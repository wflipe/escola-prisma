---
import TopBar from '../components/layout/TopBar.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFloat from '../components/layout/WhatsAppFloat.astro';
import type { SchemaOrg } from '../utils/schema';
import '../styles/globals.css';

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  schema?: SchemaOrg | SchemaOrg[];
  noIndex?: boolean;
}

const {
  title,
  description,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  ogImage: ogImagePath = '/assets/escola-prisma-marca-1200x630.png',
  schema,
  noIndex = false,
} = Astro.props;

// Open Graph (WhatsApp, Facebook, Instagram) exige URL absoluta da imagem.
const ogImage = new URL(ogImagePath, Astro.site).href;

const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  {noIndex && <meta name="robots" content="noindex, nofollow" />}

  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <meta name="geo.region" content="BR-BA" />
  <meta name="geo.placename" content="Feira de Santana" />
  <meta name="geo.position" content="-12.2949;-38.9457" />
  <meta name="ICBM" content="-12.2949, -38.9457" />

  <meta name="theme-color" content="#F67A21" />

  {schemas.map((item) => (
    <script type="application/ld+json" set:html={JSON.stringify(item)} />
  ))}

  <!-- Umami (estatísticas de visitas, sem cookies). data-domains: só conta o site oficial, não localhost nem previews da Vercel. -->
  <script
    is:inline
    defer
    src="https://cloud.umami.is/script.js"
    data-website-id="531d3b02-006f-478e-896b-36b7a394d576"
    data-domains="www.escolaprisma.net.br,escolaprisma.net.br"
  ></script>

  <!-- Microsoft Clarity (mapas de calor e gravações de sessão). Só no domínio oficial e depois do carregamento da página, para não pesar na performance. -->
  <script is:inline>
    (function (c, l, a, r, i, t, y) {
      if (!/(^|\.)escolaprisma\.net\.br$/.test(l.location.hostname)) return;
      c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
      function carregar() {
        t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
      }
      if (l.readyState === 'complete') carregar();
      else c.addEventListener('load', carregar);
    })(window, document, 'clarity', 'script', 'zda9hbje8t');
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;700;800&family=Instrument+Serif:ital@0;1&family=Montserrat:wght@300;400;500;600&display=swap" />
</head>
<body>


  <TopBar />
  <Header />
  <MobileMenu />

  <main id="main-content">
    <slot />
  </main>

  <Footer />
  <WhatsAppFloat />

  <button id="back-to-top" class="back-to-top" aria-label="Voltar ao topo" hidden>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m18 15-6-6-6 6" />
    </svg>
  </button>



  <script>
    import '../scripts/mobile-menu';
    import '../scripts/back-to-top';
    import '../scripts/analytics';
  </script>
</body>
</html>