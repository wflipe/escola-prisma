---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { whatsappLink } from '../data/escola';
import type { Pagina404Data } from '../types/content';
import pagina404Data from '../content/site/pagina-404.json';

/** Textos em src/content/site/pagina-404.json (painel: "Página não encontrada (404)"). */
const data = pagina404Data as Pagina404Data;
// prefixoMenu="/": nesta página os links do menu são "/#proposta", "/#fases"...
// (as seções só existem na página inicial). Na home continuam "#proposta".
// Única diferença do cabeçalho/menu desta página em relação à home.
---

<BaseLayout
  title={data.tituloAba}
  description={data.descricao}
  noIndex={true}
  prefixoMenu="/"
>
  <section class="not-found">
    <Container>
      <p class="code">404</p>
      <h1>{data.titulo}</h1>
      <p class="lead">
        {data.texto}
      </p>
      <div class="actions">
        <Button href="/" variant="primary" size="lg">
          {data.botaoInicio}
        </Button>
        <Button
          href={whatsappLink(data.botaoWhatsapp.whatsappAssunto)}
          target="_blank"
          rel="noopener noreferrer"
          variant="outline"
          size="lg"
          data-ga4-event="click_whatsapp"
          data-ga4-location="404"
        >
          <Icon name="whatsapp" size="sm" />
          {data.botaoWhatsapp.text}
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding: 6rem 0;
    text-align: center;
  }

  .code {
    font-family: var(--font-heading);
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 800;
    line-height: 1;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 1rem;
  }

  .lead {
    max-width: 36rem;
    margin: 0 auto 2rem;
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
</style>
